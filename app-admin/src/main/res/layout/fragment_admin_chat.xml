<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:background="@color/surface"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- AI Bot Avatar -->
        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="@color/primary"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="🤖"
                android:textSize="20sp"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trợ Lý Thông Minh AI"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Luôn sẵn sàng hỗ trợ bạn 24/7"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot_green" />
    </LinearLayout>

    <!-- ===== CHAT MESSAGE LIST ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:layout_constraintBottom_toTopOf="@id/layout_chips"
        tools:listitem="@layout/item_chat_bubble_bot" />

    <!-- ===== QUICK ACTION CHIPS ===== -->
    <HorizontalScrollView
        android:id="@+id/layout_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:scrollbars="none"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@id/layout_input">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_overview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="📊 Tổng quan hôm nay"
                android:textColor="@color/primary"
                app:chipBackgroundColor="@color/secondary_light"
                app:chipStrokeColor="@color/primary"
                app:chipStrokeWidth="1dp"
                style="@style/Widget.Material3.Chip.Assist" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="⏳ Đơn chờ xử lý"
                android:textColor="@color/primary"
                app:chipBackgroundColor="@color/secondary_light"
                app:chipStrokeColor="@color/primary"
                app:chipStrokeWidth="1dp"
                style="@style/Widget.Material3.Chip.Assist" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_late"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="🚨 Đơn giao trễ"
                android:textColor="@color/error"
                app:chipBackgroundColor="@color/error_translucent"
                app:chipStrokeColor="@color/error"
                app:chipStrokeWidth="1dp"
                style="@style/Widget.Material3.Chip.Assist" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_low_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="📦 Sắp hết hàng"
                android:textColor="@color/warning"
                app:chipBackgroundColor="@color/warning_translucent"
                app:chipStrokeColor="@color/warning"
                app:chipStrokeWidth="1dp"
                style="@style/Widget.Material3.Chip.Assist" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cancel_risk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❌ Nguy cơ hủy đơn"
                android:textColor="@color/error"
                app:chipBackgroundColor="@color/error_translucent"
                app:chipStrokeColor="@color/error"
                app:chipStrokeWidth="1dp"
                style="@style/Widget.Material3.Chip.Assist" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== INPUT BOX ===== -->
    <LinearLayout
        android:id="@+id/layout_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="@color/surface_variant"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">
            <EditText
                android:id="@+id/et_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Hỏi trợ lý (tra đơn ORD-..., trễ, tổng quan...)"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:background="@android:color/transparent"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:maxLines="4"
                android:inputType="textShortMessage"
                android:importantForAutofill="no" />
        </androidx.cardview.widget.CardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_send"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_send"
            app:backgroundTint="@color/primary"
            app:tint="@color/white"
            app:fabSize="mini"
            android:contentDescription="Gửi tin" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
