<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Action Badge -->
            <TextView
                android:id="@+id/tv_audit_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_light"
                android:backgroundTint="@color/primary_translucent"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Cập nhật đơn hàng"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_audit_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="2026-05-22 15:40:12"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_audit_operator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Thực hiện bởi: Lê Hoàng Admin (admin)"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_audit_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đối tượng: ORD-9843A"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_audit_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Chi tiết: Thay đổi trạng thái từ 'pending' sang 'confirmed'"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
