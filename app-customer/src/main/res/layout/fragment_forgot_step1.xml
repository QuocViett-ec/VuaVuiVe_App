<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Nhập số điện thoại hoặc email đã đăng ký"
        android:textColor="@color/text_primary" android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_phone_email"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="@string/hint_phone_or_email"
        app:boxStrokeColor="@color/primary">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_phone_email"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textEmailAddress" android:maxLines="1"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView android:id="@+id/tv_error" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="" android:textColor="@color/error"
        android:textSize="13sp" android:layout_marginBottom="12dp" android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="Gửi OTP" android:textSize="16sp"
        app:backgroundTint="@color/primary" app:cornerRadius="12dp"/>

    <ProgressBar android:id="@+id/progress_bar"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:layout_marginTop="12dp"
        android:indeterminateTint="@color/primary" android:visibility="gone"/>
</LinearLayout>
