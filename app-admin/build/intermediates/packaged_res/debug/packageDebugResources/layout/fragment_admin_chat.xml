<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Custom Header Bar -->
    <RelativeLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="AI ASSISTANT (TRỢ LÝ THÔNG MINH)"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Chat Message List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="12dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:layout_constraintBottom_toTopOf="@id/layout_chips"
        tools:listitem="@layout/item_chat_bubble_bot" />

    <!-- Quick action chips scrollable -->
    <HorizontalScrollView
        android:id="@+id/layout_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@id/layout_input">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_overview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng quan hôm nay"
                app:chipBackgroundColor="@color/surface"
                android:textColor="@color/text_primary"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đơn chờ xử lý"
                app:chipBackgroundColor="@color/surface"
                android:textColor="@color/text_primary"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_late"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đơn giao trễ"
                app:chipBackgroundColor="@color/surface"
                android:textColor="@color/text_primary"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_low_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sắp hết hàng"
                app:chipBackgroundColor="@color/surface"
                android:textColor="@color/text_primary"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cancel_risk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nguy cơ hủy đơn"
                app:chipBackgroundColor="@color/surface"
                android:textColor="@color/text_primary"
                style="@style/Widget.Material3.Chip.Assist" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Input Box -->
    <LinearLayout
        android:id="@+id/layout_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Hỏi trợ lý (tra đơn ORD-..., trễ, tổng quan...)"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:maxLines="4"
            android:inputType="textShortMessage"
            android:importantForAutofill="no" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_send"
            android:contentDescription="Gửi tin"
            app:tint="@color/primary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
