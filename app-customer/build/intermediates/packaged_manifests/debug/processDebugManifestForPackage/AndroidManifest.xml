<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="vn.vuavuive.customer"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <permission
        android:name="vn.vuavuive.customer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="vn.vuavuive.customer.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="vn.vuavuive.customer.VuaVuiVeApp"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.VuaVuiVe.Customer"
        android:usesCleartextTraffic="true" >

        <!-- Auth -->
        <activity
            android:name="vn.vuavuive.customer.ui.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.VuaVuiVe.Customer" />
        <activity
            android:name="vn.vuavuive.customer.ui.auth.RegisterActivity"
            android:exported="false" />
        <activity
            android:name="vn.vuavuive.customer.ui.auth.ForgotPasswordActivity"
            android:exported="false" />

        <!-- Main -->
        <activity
            android:name="vn.vuavuive.customer.ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Product -->
        <activity
            android:name="vn.vuavuive.customer.ui.product.ProductDetailActivity"
            android:exported="false"
            android:parentActivityName="vn.vuavuive.customer.ui.MainActivity" />
        <activity
            android:name="vn.vuavuive.customer.ui.search.SearchActivity"
            android:exported="false"
            android:parentActivityName="vn.vuavuive.customer.ui.MainActivity" />

        <!-- Checkout & Payment -->
        <activity
            android:name="vn.vuavuive.customer.ui.checkout.CheckoutActivity"
            android:exported="false"
            android:parentActivityName="vn.vuavuive.customer.ui.MainActivity" />
        <activity
            android:name="vn.vuavuive.customer.ui.checkout.PaymentWebViewActivity"
            android:exported="false"
            android:parentActivityName="vn.vuavuive.customer.ui.checkout.CheckoutActivity" />

        <!-- Order Detail -->
        <activity
            android:name="vn.vuavuive.customer.ui.order.OrderDetailActivity"
            android:exported="false"
            android:parentActivityName="vn.vuavuive.customer.ui.MainActivity" />

        <!-- Reviews -->
        <activity
            android:name="vn.vuavuive.customer.ui.review.MyReviewsActivity"
            android:exported="false"
            android:parentActivityName="vn.vuavuive.customer.ui.MainActivity" />

        <!-- Shipments -->
        <activity
            android:name="vn.vuavuive.customer.ui.shipment.ShipmentListActivity"
            android:exported="false"
            android:parentActivityName="vn.vuavuive.customer.ui.MainActivity" />
        <activity
            android:name="vn.vuavuive.customer.ui.shipment.ShipmentDetailActivity"
            android:exported="false"
            android:parentActivityName="vn.vuavuive.customer.ui.shipment.ShipmentListActivity" />

        <!-- Account -->
        <activity
            android:name="vn.vuavuive.customer.ui.account.EditProfileActivity"
            android:exported="false"
            android:parentActivityName="vn.vuavuive.customer.ui.MainActivity" />
        <activity
            android:name="vn.vuavuive.customer.ui.account.ChangePasswordActivity"
            android:exported="false"
            android:parentActivityName="vn.vuavuive.customer.ui.MainActivity" />

        <!-- Chat / Chatbot -->
        <activity
            android:name="vn.vuavuive.customer.ui.chat.ChatActivity"
            android:exported="false"
            android:parentActivityName="vn.vuavuive.customer.ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Recipes -->
        <activity
            android:name="vn.vuavuive.customer.ui.recipe.RecipeListFragmentActivity"
            android:exported="false"
            android:parentActivityName="vn.vuavuive.customer.ui.MainActivity" />
        <activity
            android:name="vn.vuavuive.customer.ui.recipe.RecipeDetailActivity"
            android:exported="false"
            android:parentActivityName="vn.vuavuive.customer.ui.recipe.RecipeListFragmentActivity" />
        <activity
            android:name="com.google.android.gms.common.api.GoogleApiActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="vn.vuavuive.customer.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />
    </application>

</manifest>